# zhizhang-server 环境变量

# 应用
ZHIZHANG_APP_ENV=dev
ZHIZHANG_APP_PORT=8388

# JWT
ZHIZHANG_JWT_SECRET=your-super-secret-key-here
ZHIZHANG_JWT_ACCESS_TTL=7200
ZHIZHANG_JWT_REFRESH_TTL=604800

# 数据库
ZHIZHANG_DATABASE_HOST=localhost
ZHIZHANG_DATABASE_PORT=5432
ZHIZHANG_DATABASE_DATABASE=zhizhang
ZHIZHANG_DATABASE_USERNAME=postgres
ZHIZHANG_DATABASE_PASSWORD=postgres

# Redis
ZHIZHANG_REDIS_HOST=localhost
ZHIZHANG_REDIS_PORT=6379
ZHIZHANG_REDIS_PASSWORD=
ZHIZHANG_REDIS_DB=0

# 日志
ZHIZHANG_LOG_LEVEL=debug
ZHIZHANG_LOG_FORMAT=console

# 企业微信（自建应用，见 docs/wecom-setup.md）
ZHIZHANG_WECOM_CORPID=
ZHIZHANG_WECOM_AGENTID=
ZHIZHANG_WECOM_SECRET=
ZHIZHANG_WECOM_INVITE_QR_URL=
ZHIZHANG_WECOM_REDIRECT_HOST=

# 微信小程序（getPhoneNumber 换手机号）
ZHIZHANG_WECHAT_MP_APPID=
ZHIZHANG_WECHAT_MP_SECRET=
