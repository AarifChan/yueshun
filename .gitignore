# ========== Go ==========
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
# vendor/

# Go workspace file
go.work
go.work.sum

# Air live reload
/tmp/
tmp/

# ========== Node / Frontend ==========
node_modules/

# Build output
/build/
/dist/
/bin/

# Vite / uni-app cache
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lint / style cache
.stylelintcache
.eslintcache

# NOTE: app/ 与 frontend/ 各自的 .gitignore 负责子目录细节，
# 本节仅作为兜底，避免误提交构建产物与依赖。

# ========== 环境变量与密钥 ==========
.env
.env.local
.env.*.local
# 模板文件允许提交
!.env.example
!.env.sample
!.env.template
# app/env/ 下的 uni-app 环境配置按项目约定入库（不含密钥）
!app/env/.env.*

# ========== 数据库 ==========
*.db
*.sqlite
*.sqlite3

# ========== IDE / 编辑器 ==========
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# ========== 操作系统 ==========
.DS_Store
Thumbs.db

# ========== 其他 ==========
# Temporary files
/temp/
temp/

# Swagger generated docs (docs/docs.go, swagger.json, swagger.yaml 由 scripts/gen-swagger.sh 生成，当前已入库跟踪)
# docs/docs.go
# docs/swagger.json
# docs/swagger.yaml
